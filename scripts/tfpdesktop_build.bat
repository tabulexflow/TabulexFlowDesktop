:: 目标平台：前端程序需要编译并部署于 Windows、Debian、Red Hat 系统。
:: 注意：字符编码是ANSI，确保在Windows上运行，不是UTF-8编码
@echo off
:: 确保 %SystemRoot%\System32 在 PATH 中：某些启动方式（IDE/ConEmu 集成终端等）会
:: 继承到不含 System32 的 PATH，导致 chcp/findstr/tasklist/taskkill/timeout 等系统
:: 命令报 "not recognized"，进而引发后续批处理解析错位（如 else was unexpected）。
:: 这里在最前面幂等地补回，避免脚本对启动环境过度依赖。
if not defined SystemRoot set "SystemRoot=C:\Windows"
set "PATH=%SystemRoot%\System32;%SystemRoot%;%SystemRoot%\System32\Wbem;%PATH%"
chcp 65001 >nul

:: ==========================================
:: Configuration - Modify these values as needed
:: ==========================================
cls
set "scriptPath=%~dp0"
set "PROJECT_DIR=%scriptPath%.."

:: Check if conda is installed
where conda >nul 2>&1
if %errorlevel% equ 0 (
    echo Detected conda, activating py312tf environment...
    call conda activate py312tf
) else (
    echo Conda not detected, continuing...
)

:: ==========================================
:: Build mode selection (v3.9)
:: ==========================================
echo ==========================================
echo  TabulexFlowDesktop Build Configuration
echo ==========================================
echo.
echo  Select build mode:
echo.
echo  [1] Production (default)
echo      EXE connects to https://tabulexflow.com:443
echo      Fallback to 127.0.0.1:8080 is BLOCKED
echo      Sub-tools download EXE ZIP from backend
echo      Full security checks enforced
echo.
echo  [2] Local Test
echo      EXE connects to http://127.0.0.1:8080
echo      Fallback to public backend is BLOCKED
echo      Sub-tools download EXE ZIP from backend
echo      EXE name has -devtest suffix
echo      For development testing ONLY, do NOT distribute
echo.
set /p "BUILD_CHOICE=Enter choice [1-2] (default=1): "
if "%BUILD_CHOICE%"=="" set "BUILD_CHOICE=1"
if "%BUILD_CHOICE%"=="1" (
    set "TFP_BUILD_TARGET_FRONTEND=production"
    echo.
    echo  [Selected] Production build
) else if "%BUILD_CHOICE%"=="2" (
    set "TFP_BUILD_TARGET_FRONTEND=localtest"
    echo.
    echo  [Selected] Local Test build - FOR DEVELOPMENT ONLY
) else (
    echo.
    echo  Invalid choice. Defaulting to Production build.
    set "TFP_BUILD_TARGET_FRONTEND=production"
)
echo.

:: ==========================================
:: Package mode selection
:: ==========================================
echo  Select package mode:
echo.
echo  [1] Single-file (default)
echo      Everything packed into one EXE, easier to distribute
echo.
echo  [2] Directory mode
echo      EXE + dependencies in a folder, faster startup
echo.
set /p "PKG_CHOICE=Enter choice [1-2] (default=1): "
if "%PKG_CHOICE%"=="" set "PKG_CHOICE=1"
if "%PKG_CHOICE%"=="1" (
    set "TFP_PACKAGE_MODE=onefile"
    echo.
    echo  [Selected] Single-file mode
) else if "%PKG_CHOICE%"=="2" (
    set "TFP_PACKAGE_MODE=onedir"
    echo.
    echo  [Selected] Directory mode
) else (
    echo.
    echo  Invalid choice. Defaulting to Single-file mode.
    set "TFP_PACKAGE_MODE=onefile"
)
echo.

:: ==========================================
:: Build edition selection (OSS Community vs Full)
:: ==========================================
echo  Select build edition:
echo.
echo  [1] OSS Community Edition (default)
echo      Pure frontend + BuiltinProgram only
echo      Hides login/backend/remote tools
echo.
echo  [2] Full Edition
echo      Includes login + remote tools ^(RemoteProgram/RemoteWebpage^)
echo      Connects to backend
echo.
set /p "OSS_CHOICE=Enter choice [1-2] (default=1): "
if "%OSS_CHOICE%"=="" set "OSS_CHOICE=1"
if "%OSS_CHOICE%"=="1" (
    set "TFP_OSS_MODE=oss"
    echo.
    echo  [Selected] OSS Community Edition ^(default^)
) else if "%OSS_CHOICE%"=="2" (
    set "TFP_OSS_MODE=full"
    echo.
    echo  [Selected] Full Edition ^(with login ^& remote tools^)
) else (
    echo.
    echo  Invalid choice. Defaulting to OSS Community Edition.
    set "TFP_OSS_MODE=oss"
)
echo.

:: Record start time (after last user interaction)
python -c "import time;print(int(time.time()))" > "%TEMP%\tfpdesktop_build_t0.txt" 2>nul
set /p SCRIPT_T0=<"%TEMP%\tfpdesktop_build_t0.txt"
del "%TEMP%\tfpdesktop_build_t0.txt" 2>nul

:: Write _build_target.py so build_mode.py can read it at EXE runtime
:: This file is packaged into the EXE by PyInstaller (see build.spec)
echo # Auto-generated by tfpdesktop_build.bat - DO NOT EDIT MANUALLY > "%PROJECT_DIR%\_build_target.py"
echo BUILD_TARGET_FRONTEND = "%TFP_BUILD_TARGET_FRONTEND%" >> "%PROJECT_DIR%\_build_target.py"
echo Written _build_target.py: BUILD_TARGET_FRONTEND=%TFP_BUILD_TARGET_FRONTEND%

echo ==========================================
echo Building TabulexFlowDesktop project...
echo Build mode: %TFP_BUILD_TARGET_FRONTEND%
echo Edition: %TFP_OSS_MODE%
echo Package mode: %TFP_PACKAGE_MODE%
echo ==========================================

:: Change to project directory
cd /d "%PROJECT_DIR%"

:: Read DEFAULT_TOOL from main.py - simple batch approach
setlocal enabledelayedexpansion
set "FOUND_TOOL="
for /f "usebackq tokens=*" %%a in (`findstr /r "^DEFAULT_TOOL" "%PROJECT_DIR%\main.py"`) do (
    set "line=%%a"
    for /f "tokens=2 delims==" %%b in ("!line!") do (
        set "FOUND_TOOL=%%b"
    )
)
endlocal & set "DEFAULT_TOOL=%FOUND_TOOL%"

:: Handle empty string or whitespace as "main" first, so the quote-stripping below
:: never runs on an empty value (which would produce a malformed `set "X="="` command
:: and corrupt batch parsing, e.g. orphaned `else`).
if not defined DEFAULT_TOOL set "DEFAULT_TOOL=main"
if "%DEFAULT_TOOL%"=="" set "DEFAULT_TOOL=main"

:: Remove all quotes from DEFAULT_TOOL
set "DEFAULT_TOOL=%DEFAULT_TOOL:"=%"
set "DEFAULT_TOOL=%DEFAULT_TOOL:'=%"

:: Trim leading/trailing spaces
for /f "tokens=*" %%a in ("%DEFAULT_TOOL%") do set "DEFAULT_TOOL=%%a"

:: If trimming left it empty, fall back to "main" again
if not defined DEFAULT_TOOL set "DEFAULT_TOOL=main"
if "%DEFAULT_TOOL%"=="" set "DEFAULT_TOOL=main"

:: Set base exe name based on DEFAULT_TOOL
if "%DEFAULT_TOOL%"=="main" (
    set "BASE_EXE_NAME=TabulexFlow"
) else (
    set "BASE_EXE_NAME=%DEFAULT_TOOL%"
)

:: Frontend version single source: config/version.txt ProductVersion (shared helper, T1.2)
set "FE_VERSION="
for /f "usebackq delims=" %%v in (`python "%~dp0scripts_py\tfpdesktop_version.py" "%PROJECT_DIR%"`) do set "FE_VERSION=%%v"
if not defined FE_VERSION (
    echo   [FAIL] Cannot read frontend version from config/version.txt. Aborting build.
    exit /b 1
)

:: Edition label (OSS / Full) baked into the artifact name
if "%TFP_OSS_MODE%"=="oss" (
    set "EDITION_LABEL=OSS"
) else (
    set "EDITION_LABEL=Full"
)

:: Final artifact name: <Base>-<version>-<Edition>[-devtest]
:: Local test keeps the -devtest suffix to prevent accidental distribution
set "EXE_NAME=%BASE_EXE_NAME%-%FE_VERSION%-%EDITION_LABEL%"
if "%TFP_BUILD_TARGET_FRONTEND%"=="localtest" (
    set "EXE_NAME=%EXE_NAME%-devtest"
)

echo Default tool: %DEFAULT_TOOL%
echo Frontend version: %FE_VERSION%
echo Edition: %EDITION_LABEL%
echo EXE name: %EXE_NAME%

:: Export final name so build.spec produces it directly (no post-build rename)
set "TFP_EXE_NAME=%EXE_NAME%"

:: Check and close running exe
tasklist | findstr /i "%EXE_NAME%.exe" >nul
if %errorlevel% equ 0 (
    echo Found running %EXE_NAME%.exe, closing...
    taskkill /f /im "%EXE_NAME%.exe" >nul 2>&1
    timeout /t 2 /nobreak >nul
    echo Process closed
) else (
    echo No running %EXE_NAME%.exe found
)

echo Cleaning previous builds...
echo Cleaning PyInstaller build cache...
if exist "%PROJECT_DIR%\__pycache__" rmdir /s /q "%PROJECT_DIR%\__pycache__"
:: 不再整体删除 dist：仅移除本次构建目标，保留另一平台（Windows/Linux）已编译产物与校验清单，
:: 避免 Windows 与 Linux 构建相互删除对方产物。
if "%TFP_PACKAGE_MODE%"=="onedir" (
    if exist "%PROJECT_DIR%\dist\%EXE_NAME%" rmdir /s /q "%PROJECT_DIR%\dist\%EXE_NAME%"
) else (
    if exist "%PROJECT_DIR%\dist\%EXE_NAME%.exe" del /f /q "%PROJECT_DIR%\dist\%EXE_NAME%.exe"
)
if not exist "%PROJECT_DIR%\dist" mkdir "%PROJECT_DIR%\dist"
:: Clean PyInstaller internal build folder
if exist "%PROJECT_DIR%\build" (
    echo Cleaning build directory...
    rmdir /s /q "%PROJECT_DIR%\build"
)

:: ===== OSS 合规（L-8）：清理源码树 config\ 内运行时残留的凭据文件 =====
:: tfp_secure_storage 在本机运行（源码或本地测试产物）时可能把 fallback 凭据
:: 写到源码树 config\ 目录（如 .auth_token、.tfp_fernet_key）；构建前统一删除，
:: 防止其随源码仓库或源码压缩包泄露。仅删除运行时残留命名模式，不影响正常配置文件。
for %%f in ("%PROJECT_DIR%\config\.auth_*" "%PROJECT_DIR%\config\.session*" "%PROJECT_DIR%\config\.tfp_fernet_key") do (
    if exist "%%f" (
        del /f /q "%%f"
        echo Deleted source-tree residual credential file: %%f
    )
)

:: ===== OSS 合规：清理源码树内闭源子工具残留（RemoteProgram / RemoteWebpage + 本地 EXE 完整性清单）=====
:: tools_fe\tools_remote_program、tools_fe\tools_remote_webpage 为运行时从后端下载的闭源工具目录
:: （含 app_icon.ico 等资源），tools_fe\.tfp_manifests 为本地独占的 EXE 哈希清单；三者均不属于
:: 开源发布内容。构建前统一移除，避免被源码压缩包 / 非 git 打包方式夹带。
for %%d in ("%PROJECT_DIR%\tools_fe\tools_remote_program" "%PROJECT_DIR%\tools_fe\tools_remote_webpage" "%PROJECT_DIR%\tools_fe\.tfp_manifests") do (
    if exist "%%~d" (
        rmdir /s /q "%%~d"
        echo Removed closed-source sub-tool residue: %%~d
    )
)

echo Building %EXE_NAME%...
echo Using config/build.spec configuration...

:: ==========================================
:: Security pre-build self-check (v3.6/v3.9)
:: Fail-fast if the production-mode mechanism is broken
:: ==========================================
echo.
echo [1/2] Checking build_mode.py production mechanism...
if not exist "%PROJECT_DIR%\build_mode.py" (
    echo   [FAIL] build_mode.py missing. Aborting build.
    exit /b 1
)
set "BM_BUILD="
for /f "delims=" %%v in ('python -c "import sys; sys.path.insert(0, r'%PROJECT_DIR%'); from build_mode import IS_PRODUCTION_BUILD; print(IS_PRODUCTION_BUILD)"') do set "BM_BUILD=%%v"
if not defined BM_BUILD (
    echo   [FAIL] Cannot evaluate build_mode.IS_PRODUCTION_BUILD. Aborting build.
    exit /b 1
)
if "%BM_BUILD%"=="True" (
    echo   [FAIL] build_mode.IS_PRODUCTION_BUILD is True in source tree.
    echo         Expected False before packaging ^(PyInstaller sets sys.frozen at runtime^).
    echo         Aborting build to avoid shipping a misconfigured EXE.
    exit /b 1
)
echo   [OK] build_mode.py is healthy (source mode)

echo [2/2] Checking backend-address hardcodes in core files... ^(warning-only for open-source builds^)
:: Open-source project: forbidding 127.0.0.1 etc. is ineffective, so this is warning-only, not fatal.
set "BAD_HARDC="
for %%f in ("%PROJECT_DIR%\main.py" "%PROJECT_DIR%\build_mode.py" "%PROJECT_DIR%\tfp_utils\tfp_backend_config.py" "%PROJECT_DIR%\tfp_auth\tfp_auth_manager.py") do (
    findstr /n /c:"http://127.0.0.1" /c:"http://localhost" "%%f" >nul 2>&1 && set "BAD_HARDC=%%f"
)
if defined BAD_HARDC (
    echo   [WARN] Found "http://127.0.0.1" or "http://localhost" hardcoded in %BAD_HARDC%
    echo         This is an open-source project; frontend is not required to forbid local backend addresses.
    echo         Build continues.
) else (
    echo   [OK] No insecure backend-address hardcodes found
)

if "%TFP_BUILD_TARGET_FRONTEND%"=="localtest" (
    echo   [INFO] Local test EXE will use backend: http://127.0.0.1:8080
) else (
    echo   [INFO] Production EXE will use fixed backend: https://tabulexflow.com:443
)
echo.

echo [3/3] Checking config/version.txt placeholder value... ^(T1.4^)
:: Frontend version single source is ProductVersion in config/version.txt (read by main.py at startup).
:: Check logic has a single implementation in tfpdesktop_version_check.py (shared by bat/sh), thin call here.
python "%~dp0scripts_py\tfpdesktop_version_check.py" "%PROJECT_DIR%"
if errorlevel 1 (
    echo   [FAIL] Frontend version check failed. Aborting build.
    exit /b 1
)
echo.

:: ==========================================
:: OSS community build flag: set True before compile ONLY for OSS Community edition so it gets packaged.
:: OSS build = "pure frontend + BuiltinProgram", hides login/backend/remote tools.
:: Full edition keeps False (with login & remote tools).
:: Restored to False right after compile, so normal dev/test of backend & paid tools continue to work.
:: ==========================================
if "%TFP_OSS_MODE%"=="oss" (
    echo [OSS] Setting build_mode.IS_OSS_COMMUNITY_BUILD to True temporarily...
    python -c "import io,re;p=io.open(r'%PROJECT_DIR%\build_mode.py','r',encoding='utf-8').read();p=re.sub(r'IS_OSS_COMMUNITY_BUILD = False','IS_OSS_COMMUNITY_BUILD = True',p,count=1);io.open(r'%PROJECT_DIR%\build_mode.py','w',encoding='utf-8',newline='').write(p)"
) else (
    echo [Full] Full edition build: keeping IS_OSS_COMMUNITY_BUILD=False ^(with login ^& remote tools^)
)

:: Use --clean to ensure clean build
:: TFP_PACKAGE_MODE env var is read by build.spec to select onefile/onedir
pyinstaller --clean "%PROJECT_DIR%\config\build.spec"

:: Restore OSS flag to False after compile
echo [OSS] Restoring build_mode.IS_OSS_COMMUNITY_BUILD to False...
python -c "import io,re;p=io.open(r'%PROJECT_DIR%\build_mode.py','r',encoding='utf-8').read();p=re.sub(r'IS_OSS_COMMUNITY_BUILD = True','IS_OSS_COMMUNITY_BUILD = False',p,count=1);io.open(r'%PROJECT_DIR%\build_mode.py','w',encoding='utf-8',newline='').write(p)"

:: Determine EXE path based on package mode
:: Final name (with version + edition + optional -devtest) is produced directly by build.spec
if "%TFP_PACKAGE_MODE%"=="onedir" (
    set "EXE_PATH=%PROJECT_DIR%\dist\%EXE_NAME%\%EXE_NAME%.exe"
    set "DIST_DIR=%PROJECT_DIR%\dist\%EXE_NAME%"
) else (
    set "EXE_PATH=%PROJECT_DIR%\dist\%EXE_NAME%.exe"
    set "DIST_DIR=%PROJECT_DIR%\dist"
)

echo Build process completed, checking output...
timeout /t 3 /nobreak >nul

:: Check output locations
if exist "%EXE_PATH%" (
    set "BUILD_OK=1"
    echo.
    echo Build successful!
    if "%TFP_BUILD_TARGET_FRONTEND%"=="localtest" (
        echo Security: LOCAL TEST build - backend fixed to http://127.0.0.1:8080
        echo WARNING: This EXE is for development testing ONLY. Do NOT distribute!
    ) else (
        echo Security: production mode is baked in ^(backend fixed to https://tabulexflow.com:443^)
    )
    echo Executable location: %EXE_PATH%

    :: Check file size using for loop
    for %%F in ("%EXE_PATH%") do set "filesize=%%~zF"

    setlocal enabledelayedexpansion

    set /a "size_kb=!filesize!/1024"
    set /a "size_mb=!size_kb!/1024"
    set /a "remainder_kb=!size_kb!%%1024"
    set /a "fraction=!remainder_kb!*100/1024"

    if !fraction! LSS 10 (
        echo File size: !size_mb!.0!fraction! MB
    ) else (
        echo File size: !size_mb!.!fraction! MB
    )

    endlocal

    if "%TFP_BUILD_TARGET_FRONTEND%"=="localtest" (
        :: Local test build: do NOT distribute
        echo.
        echo Local test build - do NOT distribute!
        echo Run the EXE directly from: %EXE_PATH%
    ) else (
        :: 正常生产构建：不再自动复制到后端目录（开源版）。产物留在 dist\ 下即可。
        echo.
        echo Build output is in: %PROJECT_DIR%\dist
        echo Copy/run the EXE manually, or distribute as needed.
    )

    :: Clean build directory after build
    if exist "%PROJECT_DIR%\build" (
        echo Cleaning build directory...
        rmdir /s /q "%PROJECT_DIR%\build"
    )
) else (
    echo.
    echo Build failed! Executable not found at: %EXE_PATH%
    echo Checking what was actually created in dist folder:
    dir /b "%PROJECT_DIR%\dist\*.exe" 2>nul
    if errorlevel 1 echo No exe files found in dist folder
)

:: ===== OSS 合规（L-8）：清理 dist 内可能残留的敏感凭据文件 =====
:: 与 scripts/tfpdesktop_build.sh 的清理逻辑保持一致
if "%BUILD_OK%"=="1" call :sub_clean_sensitive_creds

:: ===== 生成 SHA-256 校验清单（dist\SHA256SUMS.txt，与 Linux 打包脚本格式一致）=====
if "%BUILD_OK%"=="1" call :sub_gen_sha256

:: --- Total script elapsed time ---
python -c "import time;print(int(time.time()))" > "%TEMP%\tfpdesktop_build_t1.txt" 2>nul
set /p SCRIPT_T1=<"%TEMP%\tfpdesktop_build_t1.txt"
del "%TEMP%\tfpdesktop_build_t1.txt" 2>nul
set /a "SCRIPT_ELAPSED=%SCRIPT_T1%-%SCRIPT_T0%"
set /a "SCRIPT_MIN=%SCRIPT_ELAPSED%/60"
set /a "SCRIPT_SEC=%SCRIPT_ELAPSED%%%60"
echo.
echo   Total script time: %SCRIPT_MIN% min %SCRIPT_SEC% sec
echo.
exit /b 0

:: ==========================================
:: Sub: clean sensitive credential files in dist (L-8)
:: ==========================================
:sub_clean_sensitive_creds
:: tfp_secure_storage 在 frozen 模式下把 fallback 凭据（如 .auth_token）写到
:: exe 同级 config\ 目录；若曾在构建机本机测试运行过 onedir 产物，这些文件
:: 可能残留在 dist\ 内。构建完成后统一扫描删除，防止被打包或误提交 git。
:: 与 scripts/tfpdesktop_build.sh 中的清理模式（.auth_* / *.auth_token / .session* /
:: .tfp_fernet_key / *.key / *.pem / credentials*）保持一致。
if not exist "%PROJECT_DIR%\dist" exit /b 0
python -c "import os,glob;p=r'%PROJECT_DIR%\dist';pats=['.auth_*','*.auth_token','.session*','.tfp_fernet_key','*.key','*.pem','credentials*'];fs=set();[fs.update(glob.glob(os.path.join(p,'**/'+x),recursive=True)) for x in pats];fs=sorted(f for f in fs if os.path.isfile(f));[print('[SECURITY] deleted: '+f) or os.remove(f) for f in fs];print('') if fs else None"
:: 方案A：移除运行时用户数据（user_setting\<用户id>\...）；目录名为登录用户 id，随 dist 分发会泄露账号身份
if exist "%PROJECT_DIR%\dist\user_setting" (
    rmdir /s /q "%PROJECT_DIR%\dist\user_setting"
    echo [SECURITY] Removed runtime user data: %PROJECT_DIR%\dist\user_setting
)
if exist "%DIST_DIR%\user_setting" (
    rmdir /s /q "%DIST_DIR%\user_setting"
    echo [SECURITY] Removed runtime user data: %DIST_DIR%\user_setting
)
:: 方案B：清除本机登录会话（keyring + config 回退文件）；否则同 OS 用户打开新产物会经钥匙串自动恢复登录
python "%~dp0scripts_py\tfpdesktop_clear_credentials.py" "%PROJECT_DIR%"
if errorlevel 1 echo   [WARN] Credential cleanup script failed ^(build continues^)
exit /b 0

:: ==========================================
:: Sub: generate SHA-256 checksum manifest (dist\SHA256SUMS.txt)
:: ==========================================
:sub_gen_sha256
:: 合并式写入：调用 scripts_py\tfpdesktop_checksum_manifest.py，仅移除同平台（Windows，
:: 即 *.exe）旧记录，保留 Linux 及其他记录，再追加本次新产物记录，两平台互不覆盖。
:: 清单格式与 Linux 打包脚本一致（"<sha256>  <相对路径>"，LF 行尾），
:: 便于在 Git Bash / WSL 下用 `sha256sum -c SHA256SUMS.txt` 校验。
:: onefile 记录 <名>.exe；onedir 记录 <名>/<名>.exe（仅主可执行文件，不含整个目录）。
:: 用 Python 写文件（LF 行尾；bat 的 echo 只能写 CRLF，会破坏 sha256sum -c 解析）。
set "ART_REL=%EXE_NAME%.exe"
if "%TFP_PACKAGE_MODE%"=="onedir" set "ART_REL=%EXE_NAME%/%EXE_NAME%.exe"
set "ART_HASH="
for /f "usebackq delims=" %%H in (`python "%~dp0scripts_py\tfpdesktop_checksum_manifest.py" --platform windows --manifest "%PROJECT_DIR%\dist\SHA256SUMS.txt" "%ART_REL%=%EXE_PATH%"`) do set "ART_HASH=%%H"
if not defined ART_HASH (
    echo   [WARN] Failed to generate SHA-256 checksum for %EXE_PATH%
    exit /b 0
)
echo Integrity checksum ^(SHA-256^): %ART_HASH%
echo Checksum manifest: %PROJECT_DIR%\dist\SHA256SUMS.txt
exit /b 0
